# KumpeApps Deployment Bot Configuration
# 
# This is a template file. Replace the placeholders below with your actual values.
#
# Placeholders to replace:
# - {{USERNAME}} - Your GitHub username
# - {{VM_HOSTNAME}} - Target VM hostname (e.g., dev-vm-01, stage-vm-01, prod-vm-01)
# - {{APP_NAME}} - Your application name (used in container names)
# - {{DOMAIN}} - Your domain (e.g., myapp-dev.example.com, myapp.example.com)

# Deployment type (currently only 'docker' is supported)
deployment_type: docker

# GitHub username of the person assigned to manage this deployment
assigned_username: {{USERNAME}}

# Target VM hostname where the application will be deployed
vm_hostname: {{VM_HOSTNAME}}

# Optional: Virtualizor plan name (if VM approval workflow is enabled)
# plan_name: standard-plan

# List of domains this application will serve
domains:
  - {{DOMAIN}}

# Path to docker-compose.yml file (relative to repository root)
docker_compose: docker-compose.yml

# Caddy reverse proxy configuration
# Keys are arbitrary labels, values are Caddyfile blocks
caddy:
  main: |
    {{DOMAIN}} {
      reverse_proxy {{APP_NAME}}:8080
    }

# Environment variable mappings: ENV_VAR_NAME: GITHUB_SECRET_NAME
# These secrets should be synced via the sync-secrets workflow
env_mappings:
  # Example: Map DATABASE_URL env var to DB_CONNECTION_STRING secret
  # DATABASE_URL: DB_CONNECTION_STRING
  # API_KEY: API_SECRET_KEY

# Deployment rules: when to deploy based on git branches
deploy_rules:
  - environment: dev
    branches:
      include:
        - develop
        - feature/**
      exclude: []
  
  - environment: stage
    branches:
      include:
        - main
        - release/**
      exclude: []
  
  - environment: prod
    branches:
      include:
        - main
      exclude:
        - feature/**
        - develop

# Optional: Override SSH port for this VM (defaults to 22)
# ssh_port: 2222

# Optional: Override SSH port for Caddy server (defaults to 22)
# caddy_ssh_port: 2222
